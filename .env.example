# Copy to .env for local development. Everything here has a free tier.

# Postgres (Neon). Without it, links live in memory and vanish on restart (local development only).
DATABASE_URL=

# Optional: a server-side RPC with better limits than the public devnet endpoint (Helius free tier works).
HELIUS_API_KEY=
# Optional: overrides the server RPC entirely.
SOLANA_RPC_URL=

# Public values, visible to the browser. Never put a key with a secret in these.
NEXT_PUBLIC_SOLANA_RPC=
# Circle's devnet USDC is used by default. Set this to use a different SPL token (for example a test token).
NEXT_PUBLIC_USDC_MINT=
# A devnet-only wallet that the "Use the demo merchant" buttons fill in.
NEXT_PUBLIC_DEMO_MERCHANT=
